{
  "name": "ac-motion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "advisor": "bun run --watch server/advisor.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "bun test",
    "snapshot": "bun scripts/snapshot.ts",
    "verify": "bun run typecheck && bun test && bun run build && bun run snapshot",
    "build:venues": "bun scripts/build_venues.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.173",
    "@anthropic-ai/sdk": "^0.104.1",
    "@mediapipe/tasks-vision": "^0.10.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-3d": "^1.26.1",
    "three": "^0.180.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.3",
    "js-yaml": "^4.1.1",
    "playwright-core": "^1.60.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
